# Plantilla de variables de entorno.
# Copiar este archivo con el nombre  .env  en la raiz del proyecto y ajustar
# los valores. El archivo .env NO se sube al repositorio (ver .gitignore).
#
#   cp env.example .env
#
# Si no se crea el archivo .env, docker-compose usa los valores por defecto
# declarados en docker-compose.yml.

DB_NAME=tareasdb
DB_USER=ciuser
DB_PASSWORD=cipassword
